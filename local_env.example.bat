rem Copy this file to local_env.bat and fill in your values. local_env.bat is ignored by git.
rem (leave the Supabase lines out if you do not use Supabase)
set SUPABASE_URL=https://YOURPROJECT.supabase.co
set SUPABASE_SERVICE_KEY=paste-service-role-key-here
set CORS_ORIGINS=*
rem ngrok fixed address (free): ngrok dashboard - Domains - create one, then put just the name here, e.g. my-name.ngrok-free.app
set NGROK_DOMAIN=my-name.ngrok-free.app
