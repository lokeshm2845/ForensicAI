# ---- API server (Hugging Face Space "Variables and secrets" / Render env) ----
CORS_ORIGINS=https://YOUR-APP.vercel.app        # comma-separated; "*" only for local development
DEVICE=cpu
STORE_FILENAMES=0                               # 0 = store "(hidden)" instead of the uploaded file name (recommended in public deployments)
MAX_UPLOAD_MB=15
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=                           # SECRET (service_role). Server only - never put it in the browser/Vercel.

# ---- Vercel project environment variables (public values) ----
API_BASE_URL=https://YOUR-SPACE.hf.space
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=                              # the *anon* key (read-only through RLS)
